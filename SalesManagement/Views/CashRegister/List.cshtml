@model IEnumerable<SalesManagement.Models.CashRegister>
@using SalesManagement.Models.Enums
@{
    ViewData["Title"] = "Histórico de Caixas";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-header">
        <span class="card-title">🔒 Histórico de Caixas</span>
    </div>

    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Data Abertura</th>
                    <th>Data Fechamento</th>
                    <th>Valor Inicial</th>
                    <th>Valor Final</th>
                    <th>Status</th>
                    <th style="width: 200px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.Id</strong></td>
                        <td>@item.OpenDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(item.CloseDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td>@item.InitialAmount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                        <td>@(item.FinalAmount?.ToString("C", new System.Globalization.CultureInfo("pt-BR")) ?? "-")</td>
                        <td>
                            @if (item.Status == CashRegisterStatus.Open)
                            {
                                <span style="color: var(--success); font-weight: 600;">🔓 Aberto</span>
                            }
                            else
                            {
                                <span style="color: var(--danger);">🔒 Fechado</span>
                            }
                        </td>
                        <td>
                            <a href="/CashRegister/Receipt/@item.Id?type=open" class="btn btn-secondary" style="padding: 0.375rem 0.75rem;">📄 Abertura</a>
                            @if (item.Status == CashRegisterStatus.Closed)
                            {
                                <a href="/CashRegister/Receipt/@item.Id?type=close" class="btn btn-primary" style="padding: 0.375rem 0.75rem;">📄 Fechamento</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
            <p>Nenhum caixa registrado.</p>
        </div>
    }
</div>