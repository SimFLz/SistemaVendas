@model SalesManagement.Models.CashRegister
@using SalesManagement.Models.Enums
@{
    ViewData["Title"] = ViewData["Type"]?.ToString() == "close" ? "Fechamento de Caixa" : "Abertura de Caixa";
    Layout = null; // 🔧 ESSENCIAL: remove sidebar/topbar
    var isClose = ViewData["Type"]?.ToString() == "close";
    var totalRevenue = ViewData["TotalRevenue"] as decimal? ?? 0;
    var totalSales = ViewData["TotalSales"] as int? ?? 0;
    var salesByPayment = ViewData["SalesByPayment"] as Dictionary<PaymentMethod, decimal> ?? new Dictionary<PaymentMethod, decimal>();
    var sales = ViewData["Sales"] as List<SalesManagement.Models.Sale> ?? new List<SalesManagement.Models.Sale>();
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalesUP</title>
    <style>
        /* ========== TELA ========== */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #1e293b;
            min-height: 100vh;
            padding: 2rem 1rem;
        }
        .page-wrapper {
            max-width: 480px;
            margin: 0 auto;
        }

        /* 🔧 HEADER DE SUCESSO (igual ao Closed.cshtml) */
        .success-header {
            text-align: center;
            margin-bottom: 1.5rem;
            color: #fff;
        }
        .success-header .icon {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }
        .success-header h2 {
            font-size: 1.3rem;
            color: #4ade80;
            margin-bottom: 0.25rem;
        }
        .success-header p {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .screen-card {
            background: #fff;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            margin-bottom: 1rem;
        }

        /* ========== RECIBO ========== */
        .receipt {
            font-family: 'Courier New', Courier, monospace;
            color: #000;
            padding: 0.5rem;
        }
        .receipt-header {
            text-align: center;
            margin-bottom: 0.75rem;
            border-bottom: 1px dashed #000;
            padding-bottom: 0.5rem;
        }
        .receipt-header .store-name {
            font-size: 1.15rem;
            font-weight: bold;
            letter-spacing: 3px;
            margin-bottom: 0.2rem;
        }
        .receipt-header .store-sub {
            font-size: 0.7rem;
            color: #334155;
        }
        .receipt-header .store-info {
            font-size: 0.75rem;
            margin-top: 0.2rem;
        }

        .line {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            margin-bottom: 0.15rem;
        }
        .line.bold { font-weight: bold; }
        .line.primary { font-weight: bold; }

        .divider {
            border: none;
            border-top: 1px dashed #000;
            margin: 0.5rem 0;
        }

        .section-title {
            font-size: 0.7rem;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 0.2rem;
            text-align: center;
        }

        .sale-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            margin-bottom: 0.1rem;
        }

        .receipt-footer {
            text-align: center;
            margin-top: 0.75rem;
            font-size: 0.7rem;
        }

        /* ========== BOTÕES ========== */
        .actions {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .btn {
            display: block;
            width: 100%;
            padding: 0.875rem;
            border-radius: 0.5rem;
            border: none;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            color: #fff;
        }
        .btn-print { background: #2563eb; }
        .btn-print:hover { background: #1d4ed8; }
        .btn-success { background: #16a34a; }
        .btn-success:hover { background: #15803d; }

        /* ========== IMPRESSÃO INFALÍVEL ========== */
        @@media print {
            @@page { size: 80mm auto; margin: 0; }

            body {
                background: #fff;
                padding: 0;
            }
            body * {
                visibility: hidden;
            }

            .receipt,
            .receipt * {
                visibility: visible;
            }

            .screen-card {
                box-shadow: none;
                border-radius: 0;
                padding: 0;
                background: transparent;
            }

            .receipt {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 0.3rem;
            }

            /* Esconde header e botões na impressão */
            .success-header,
            .actions {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrapper">

        <!-- 🔧 HEADER DE SUCESSO PARA ABERTURA -->
        @if (!isClose)
        {
            <div class="success-header">
                <div class="icon">🔓</div>
                <h2>Caixa Aberto com Sucesso!</h2>
                <p>@Model.OpenDate.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        }
        else
        {
            <div class="success-header">
                <div class="icon">✅</div>
                <h2>Caixa Fechado com Sucesso!</h2>
                <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        }

        <div class="screen-card">
            <div class="receipt">
                                <div class="receipt-header">
                    <div class="store-name">@(ViewData["StoreName"] ?? "SALESUP")</div>
                    <div class="store-sub">@(isClose ? "FECHAMENTO DE CAIXA" : "ABERTURA DE CAIXA")</div>
                    @if (ViewData["StoreCnpj"] != null)
                    {
                        <div class="store-info">CNPJ: @ViewData["StoreCnpj"]</div>
                    }
                    @if (ViewData["StoreAddress"] != null)
                    {
                        <div class="store-info">@ViewData["StoreAddress"]</div>
                    }
                    @if (ViewData["StorePhone"] != null)
                    {
                        <div class="store-info">Tel: @ViewData["StorePhone"]</div>
                    }
                    <div class="store-info">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="store-info">Caixa #@Model.Id</div>
                </div>

                <div class="line">
                    <span>Data de Abertura:</span>
                    <span>@Model.OpenDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                @if (isClose && Model.CloseDate.HasValue)
                {
                    <div class="line">
                        <span>Data de Fechamento:</span>
                        <span>@Model.CloseDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }

                <div class="line">
                    <span>Valor Inicial:</span>
                    <span>@Model.InitialAmount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                </div>

                @if (isClose)
                {
                    <div class="line">
                        <span>Valor Final:</span>
                        <span>@Model.FinalAmount?.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                    </div>

                    <hr class="divider" />

                    <div class="line bold">
                        <span>Total em Vendas:</span>
                        <span>@totalRevenue.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                    </div>
                    <div class="line">
                        <span>Nº de Vendas:</span>
                        <span>@totalSales</span>
                    </div>

                    @if (salesByPayment.Any())
                    {
                        <hr class="divider" />
                        <div class="section-title">Por Forma de Pagamento</div>
                        @foreach (var item in salesByPayment)
                        {
                            <div class="line">
                                <span>
                                    @(item.Key switch {
                                        PaymentMethod.Cash => "Dinheiro",
                                        PaymentMethod.DebitCard => "Debito",
                                        PaymentMethod.CreditCard => "Credito",
                                        PaymentMethod.Pix => "PIX",
                                        _ => item.Key.ToString()
                                    })
                                </span>
                                <span>@item.Value.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                            </div>
                        }
                    }

                    @if (sales.Any())
                    {
                        <hr class="divider" />
                        <div class="section-title">Vendas do Dia</div>
                        @foreach (var sale in sales)
                        {
                            <div class="sale-row">
                                <span>
                                    #@sale.Id - @sale.SaleDate.ToString("HH:mm")
                                    @if (sale.PaymentMethod == PaymentMethod.CreditCard)
                                    {
                                        <span>(@sale.Installments x)</span>
                                    }
                                </span>
                                <span>@sale.TotalAmount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrEmpty(Model.Observations))
                    {
                        <hr class="divider" />
                        <div class="section-title">Observacoes</div>
                        <div style="font-size:0.75rem;">@Model.Observations</div>
                    }
                }

                <div class="receipt-footer">
                    <p>@(isClose ? "Caixa fechado com sucesso!" : "Caixa aberto com sucesso!")</p>
                    <p>Obrigado!</p>
                </div>
            </div>
        </div>

        <div class="actions">
            <button onclick="window.print()" class="btn btn-print">🖨️ Imprimir</button>
            @if (!isClose)
            {
                <a href="/Sales" class="btn btn-success">🛒 Iniciar Vendas</a>
            }
            else
            {
                <a href="/Dashboard" class="btn btn-success">📊 Dashboard</a>
            }
        </div>
    </div>
</body>
</html>