@model SalesManagement.ViewModels.DailyReportViewModel
@using SalesManagement.Models.Enums
@{
    ViewData["Title"] = "Relatório Diário";
    var selectedDate = ViewData["SelectedDate"] as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem;">
    <a href="/Reports/Daily" class="btn btn-primary" style="text-decoration: none;">📈 Diário</a>
    <a href="/Reports/Monthly" class="btn btn-secondary" style="text-decoration: none;">📅 Mensal</a>
</div>

<div class="card">
    <div class="card-header">
        <span class="card-title">📈 Relatório Diário</span>
    </div>

    <form method="get" asp-action="Daily" class="search-box" style="margin-bottom: 1.5rem;">
        <input type="date" name="date" value="@selectedDate" class="form-input" style="width: 180px;" />
        <button type="submit" class="btn btn-secondary">🔍 Gerar</button>
    </form>

    <h3 style="margin-bottom: 1rem; color: var(--text-muted); font-size: 1rem;">
        📅 @Model.Date.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))
    </h3>

    <div class="dashboard-grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="stat-card">
            <div class="label">💰 Receita Total</div>
            <div class="value primary">@Model.TotalRevenue.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
        </div>
        <div class="stat-card">
            <div class="label">🛒 Nº de Vendas</div>
            <div class="value">@Model.TotalSales</div>
        </div>
        <div class="stat-card">
            <div class="label">📊 Ticket Médio</div>
            <div class="value success">@Model.AverageTicket.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
        </div>
    </div>

    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <span class="card-title">💳 Vendas por Forma de Pagamento</span>
        </div>
        @if (Model.SalesByPaymentMethod.Count > 0)
        {
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                @foreach (var item in Model.SalesByPaymentMethod)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: var(--bg); border-radius: 0.375rem;">
                        <span>
                            @(item.Key switch {
                                PaymentMethod.Cash => "💵 Dinheiro",
                                PaymentMethod.DebitCard => "💳 Cartão de Débito",
                                PaymentMethod.CreditCard => "💳 Cartão de Crédito",
                                PaymentMethod.Pix => "📱 PIX",
                                _ => item.Key.ToString()
                            })
                        </span>
                        <span style="font-weight: 600;">@item.Value.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); text-align: center; padding: 1rem;">Nenhuma venda nesta data.</p>
        }
    </div>
       <!-- Botão Fechar Caixa -->
    @{
        var cashRegister = ViewData["OpenCashRegister"] as SalesManagement.Models.CashRegister;
    }

       <!-- Botão Fechar Caixa -->
   
    @if (cashRegister != null)
    {
        <div class="card" style="margin-top: 1.5rem; border: 2px solid var(--danger);">
            <div class="card-header">
                <span class="card-title">🔒 Fechamento de Caixa</span>
            </div>
            <p style="margin-bottom: 1rem; color: var(--text-muted);">
                Caixa aberto às @cashRegister.OpenDate.ToString("HH:mm") com 
                @cashRegister.InitialAmount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
            </p>
            <form asp-controller="CashRegister" asp-action="Close" method="post" onsubmit="return confirm('Confirmar fechamento do caixa?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@cashRegister.Id" />
                <input type="hidden" name="finalAmount" value="0" />
                
                <button type="submit" class="btn btn-danger btn-lg" style="width: 100%;">
                    🔒 Fechar Caixa
                </button>
            </form>
        </div>
    }
</div>



