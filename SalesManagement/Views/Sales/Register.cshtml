@model SalesManagement.ViewModels.SaleRegisterViewModel
@using SalesManagement.Models.Enums
@{
    ViewData["Title"] = "Nova Venda";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="pdv-container">
    <!-- Lado Esquerdo: Adicionar Produtos -->
    <div class="pdv-products">
        <div class="card-header" style="margin-bottom: 1rem;">
            <span class="card-title">🛒 Adicionar Produto</span>
        </div>

        <div class="form-group">
            <label class="form-label">Código do Produto</label>
            <div style="display: flex; gap: 0.5rem;">
                <input type="text" id="productCode" class="form-input" placeholder="Digite o código de barras completo (ex: 00139990) e pressione Enter" autofocus />
                <button type="button" id="btnAddProduct" class="btn btn-primary">➕</button>
            </div>
            <span id="addProductError" style="color: var(--danger); font-size: 0.875rem; display: none;"></span>
        </div>

        <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid var(--border);" />

        <div class="card-header" style="margin-bottom: 1rem;">
            <span class="card-title">📋 Itens da Venda</span>
        </div>

        <div class="table-container">
            <table class="table" id="itemsTable">
                <thead>
                    <tr>
                        <th>Código de Barras</th>
                        <th>Produto</th>
                        <th>Qtd</th>
                        <th>Preço Unit.</th>
                        <th>Desc.</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="itemsTableBody">
                    @if (Model.Items.Count == 0)
                    {
                        <tr id="emptyRow">
                            <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                                Nenhum produto adicionado. Digite o código acima.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr data-product-id="@item.ProductId" data-price-id="@item.ProductPriceId">
                                <td><code>@item.Barcode</code></td>
                                <td>@item.ProductName</td>
                                <td>
                                    <input type="text" inputmode="numeric" class="form-input qty-input" value="@item.Quantity" min="1" style="width: 60px;" data-price-id="@item.ProductPriceId" />
                                </td>
                                <td>
                                    <input type="text" inputmode="decimal" class="form-input price-input" value="@item.UnitPrice.ToString("F2", new System.Globalization.CultureInfo("pt-BR"))" style="width: 90px;" data-price-id="@item.ProductPriceId" />
                                </td>
                                <td>
                                    <input type="text" inputmode="decimal" class="form-input discount-input" value="@item.Discount.ToString("F2", new System.Globalization.CultureInfo("pt-BR"))" style="width: 80px;" data-price-id="@item.ProductPriceId" />
                                </td>
                                <td class="item-total">@item.TotalPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-remove" data-price-id="@item.ProductPriceId" style="padding: 0.25rem 0.5rem;">🗑️</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Lado Direito: Resumo e Finalização -->
    <div class="pdv-cart">
        <div class="card-header" style="margin-bottom: 1rem;">
            <span class="card-title">💰 Resumo</span>
        </div>

        <div style="margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                <span style="color: var(--text-muted);">Subtotal:</span>
                <span id="subtotal">@Model.Subtotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                <span style="color: var(--text-muted);">Desconto Itens:</span>
                <span id="itemsDiscount">@Model.Items.Sum(i => i.Discount).ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                <span style="color: var(--text-muted);">Desconto Geral:</span>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <input type="text" inputmode="decimal" id="generalDiscount" class="form-input" value="@Model.GeneralDiscount.ToString("F2", new System.Globalization.CultureInfo("pt-BR"))" style="width: 90px;" />
                    <button type="button" id="btnApplyGeneralDiscount" class="btn btn-secondary" style="padding: 0.375rem 0.75rem;">Aplicar</button>
                </div>
            </div>
        </div>

        <div class="cart-total">
            <span>TOTAL:</span>
            <span id="totalAmount" style="color: var(--primary);">@Model.TotalAmount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
        </div>

        <form asp-action="Finalize" method="post" id="finalizeForm" style="margin-top: 1.5rem;">
            @Html.AntiForgeryToken()

            <!-- Botões para adicionar pagamento -->
            <div class="form-group">
                <label class="form-label">Formas de Pagamento *</label>
                <div class="payment-methods">
                    <button type="button" class="btn btn-payment" onclick="addPayment('Cash')">💵 Dinheiro</button>
                    <button type="button" class="btn btn-payment" onclick="addPayment('DebitCard')">💳 Débito</button>
                    <button type="button" class="btn btn-payment" onclick="addPayment('CreditCard')">💳 Crédito</button>
                    <button type="button" class="btn btn-payment" onclick="addPayment('Pix')">📱 PIX</button>
                </div>
            </div>

            <!-- Lista de pagamentos adicionados -->
            <div id="paymentsList" style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
                <p id="noPaymentsMsg" style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">Nenhuma forma de pagamento adicionada.</p>
            </div>

            <!-- Resumo de pagamento -->
            <div style="margin-top: 1rem; padding: 0.75rem; background: var(--bg); border-radius: 0.375rem; font-size: 0.95rem;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                    <span style="color: var(--text-muted);">Total a Pagar:</span>
                    <strong id="displayTotalToPay" style="font-size: 1.1rem;">R$ 0,00</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                    <span style="color: var(--text-muted);">Total Pago:</span>
                    <strong id="displayTotalPaid">R$ 0,00</strong>
                </div>
                <div id="changeRow" style="display: none; justify-content: space-between; color: var(--success); font-weight: 700; font-size: 1.1rem; margin-bottom: 0.35rem;">
                    <span>🔄 Troco:</span>
                    <span id="displayChange">R$ 0,00</span>
                </div>
                <div id="remainingRow" style="display: none; justify-content: space-between; color: var(--danger); font-weight: 700; margin-bottom: 0.35rem;">
                    <span>⚠️ Falta:</span>
                    <span id="displayRemaining">R$ 0,00</span>
                </div>
            </div>

            <button type="submit" class="btn btn-success btn-lg" style="width: 100%; margin-top: 1rem;" id="btnFinalize">
                ✅ Finalizar Venda
            </button>

            <div id="finalizeError" style="color: var(--danger); font-size: 0.875rem; text-align: center; margin-top: 0.5rem; display: none;">
                ⚠️ Adicione pelo menos um produto e uma forma de pagamento para finalizar a venda.
            </div>
        </form>

        <a href="/Sales" class="btn btn-secondary" style="width: 100%; margin-top: 0.75rem;">← Cancelar</a>
    </div>
</div>

@section Scripts {
    <script>
        function parsePtBr(value) {
            return parseFloat(value.replace(/\./g, '').replace(',', '.')) || 0;
        }

        function formatPtBr(value) {
            return value.toFixed(2).replace('.', ',');
        }

        // ========== PAGAMENTOS MÚLTIPLOS ==========
        let payments = [];

        function getPaymentLabel(method) {
            const labels = {
                'Cash': '💵 Dinheiro',
                'DebitCard': '💳 Débito',
                'CreditCard': '💳 Crédito',
                'Pix': '📱 PIX'
            };
            return labels[method] || method;
        }

        function getCurrentTotal() {
            return parsePtBr(document.getElementById('totalAmount').textContent.replace('R$ ', ''));
        }

        function addPayment(method) {
            const total = getCurrentTotal();
            const currentPaid = payments.reduce((sum, p) => sum + p.amount, 0);
            const remaining = Math.max(0, total - currentPaid);

            payments.push({
                method: method,
                amount: remaining,
                installments: 1
            });
            renderPayments();
        }

        function removePayment(index) {
            payments.splice(index, 1);
            renderPayments();
        }

        function renderPayments() {
            const container = document.getElementById('paymentsList');

            if (payments.length === 0) {
                container.innerHTML = '<p id="noPaymentsMsg" style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">Nenhuma forma de pagamento adicionada.</p>';
            } else {
                container.innerHTML = payments.map((p, index) => `
                    <div class="payment-row" style="display: flex; gap: 0.5rem; align-items: flex-end; padding: 0.5rem; background: #f1f5f9; border-radius: 0.375rem; border: 1px solid var(--border); flex-wrap: wrap;">
                        <span style="min-width: 110px; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.35rem;">
                            ${getPaymentLabel(p.method)}
                        </span>
                        <input type="hidden" name="Payments[${index}].PaymentMethod" value="${p.method}" />
                        <div style="flex: 1; min-width: 90px;">
                            <label style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 0.15rem;">Valor (R$)</label>
                            <input type="text" inputmode="decimal" name="Payments[${index}].Amount" class="form-input payment-amount" value="${formatPtBr(p.amount)}" style="width: 100%;" data-index="${index}" />
                        </div>
                        ${p.method === 'CreditCard' ? `
                        <div style="width: 130px;">
                            <label style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 0.15rem;">Parcelas</label>
                            <select name="Payments[${index}].Installments" class="form-select installment-select" style="width: 100%;" data-index="${index}">
                                ${Array.from({length: 12}, (_, i) => `<option value="${i+1}" ${p.installments === i+1 ? 'selected' : ''}>${i+1}x ${i === 0 ? 'à vista' : ''}</option>`).join('')}
                            </select>
                        </div>
                        ` : `<input type="hidden" name="Payments[${index}].Installments" value="1" />`}
                        <button type="button" onclick="removePayment(${index})" class="btn btn-danger" style="padding: 0.35rem 0.6rem;">🗑️</button>
                    </div>
                `).join('');
            }
            updatePaymentSummary();
        }

        function updatePaymentSummary() {
            const total = getCurrentTotal();
            const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
            const change = totalPaid - total;

            document.getElementById('displayTotalToPay').textContent = 'R$ ' + formatPtBr(total);
            document.getElementById('displayTotalPaid').textContent = 'R$ ' + formatPtBr(totalPaid);

            const changeRow = document.getElementById('changeRow');
            const remainingRow = document.getElementById('remainingRow');

            if (change > 0.001) {
                changeRow.style.display = 'flex';
                document.getElementById('displayChange').textContent = 'R$ ' + formatPtBr(change);
                remainingRow.style.display = 'none';
            } else if (change < -0.001) {
                remainingRow.style.display = 'flex';
                document.getElementById('displayRemaining').textContent = 'R$ ' + formatPtBr(Math.abs(change));
                changeRow.style.display = 'none';
            } else {
                changeRow.style.display = 'none';
                remainingRow.style.display = 'none';
            }
        }

        // Listeners dinâmicos para valor e parcelas
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('payment-amount')) {
                const idx = parseInt(e.target.dataset.index);
                if (!isNaN(idx)) {
                    payments[idx].amount = parsePtBr(e.target.value);
                    updatePaymentSummary();
                }
            }
            if (e.target.classList.contains('installment-select')) {
                const idx = parseInt(e.target.dataset.index);
                if (!isNaN(idx)) {
                    payments[idx].installments = parseInt(e.target.value);
                }
            }
        });

        // ========== PRODUTOS ==========
        document.getElementById('btnAddProduct').addEventListener('click', addProduct);
        document.getElementById('productCode').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addProduct();
            }
        });

        function addProduct() {
            const code = document.getElementById('productCode').value.trim();
            if (!code) return;

            const errorSpan = document.getElementById('addProductError');
            errorSpan.style.display = 'none';

            fetch('/Sales/AddItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: `productCode=${encodeURIComponent(code)}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('productCode').value = '';
                    document.getElementById('productCode').focus();
                    updateCart(data.cart);
                } else {
                    errorSpan.textContent = data.message;
                    errorSpan.style.display = 'block';
                }
            });
        }

        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('qty-input')) {
                const productPriceId = e.target.dataset.priceId;
                const quantity = parseInt(e.target.value);
                if (quantity < 1) { e.target.value = 1; return; }
                updateItem('/Sales/UpdateQuantity', `productPriceId=${productPriceId}&quantity=${quantity}`);
            }
        });

        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('price-input')) {
                const productPriceId = e.target.dataset.priceId;
                const newPrice = parsePtBr(e.target.value);
                if (newPrice <= 0) { e.target.value = '0,01'; return; }
                updateItem('/Sales/UpdatePrice', `productPriceId=${productPriceId}&newPrice=${formatPtBr(newPrice)}`);
            }
        });

        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('discount-input')) {
                const productPriceId = e.target.dataset.priceId;
                const discount = parsePtBr(e.target.value);
                updateItem('/Sales/ApplyDiscount', `productPriceId=${productPriceId}&discount=${formatPtBr(discount)}`);
            }
        });

        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-remove')) {
                const productPriceId = e.target.dataset.priceId;
                updateItem('/Sales/RemoveItem', `productPriceId=${productPriceId}`);
            }
        });

        document.getElementById('btnApplyGeneralDiscount').addEventListener('click', function() {
            const discount = parsePtBr(document.getElementById('generalDiscount').value);
            updateItem('/Sales/ApplyGeneralDiscount', `discount=${formatPtBr(discount)}`);
        });

        function updateItem(url, body) {
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: body
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    updateCart(data.cart);
                } else {
                    alert(data.message);
                }
            });
        }

        // ========== FINALIZAR ==========
        document.getElementById('finalizeForm').addEventListener('submit', function(e) {
            const emptyRow = document.getElementById('emptyRow');
            const errorDiv = document.getElementById('finalizeError');

            if (emptyRow) {
                e.preventDefault();
                errorDiv.style.display = 'block';
                document.getElementById('productCode').focus();
                return false;
            }

            if (payments.length === 0) {
                e.preventDefault();
                alert('Adicione pelo menos uma forma de pagamento.');
                return false;
            }

            const total = getCurrentTotal();
            const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);

            if (totalPaid < total - 0.001) {
                e.preventDefault();
                alert('O valor pago é menor que o total da venda. Complete o pagamento.');
                return false;
            }

            errorDiv.style.display = 'none';
        });

        function updateCart(cart) {
            const tbody = document.getElementById('itemsTableBody');
            const errorDiv = document.getElementById('finalizeError');

            if (cart.items.length === 0) {
                tbody.innerHTML = `
                    <tr id="emptyRow">
                        <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                            Nenhum produto adicionado. Digite o código acima.
                        </td>
                    </tr>`;
                errorDiv.style.display = 'none';
            } else {
                tbody.innerHTML = cart.items.map(item => `
                    <tr data-product-id="${item.productId}" data-price-id="${item.productPriceId}">
                        <td><code>${item.barcode}</code></td>
                        <td>${item.productName}</td>
                        <td>
                            <input type="text" inputmode="numeric" class="form-input qty-input" value="${item.quantity}" min="1" style="width: 60px;" data-price-id="${item.productPriceId}" />
                        </td>
                        <td>
                            <input type="text" inputmode="decimal" class="form-input price-input" value="${formatPtBr(item.unitPrice)}" style="width: 90px;" data-price-id="${item.productPriceId}" />
                        </td>
                        <td>
                            <input type="text" inputmode="decimal" class="form-input discount-input" value="${formatPtBr(item.discount)}" style="width: 80px;" data-price-id="${item.productPriceId}" />
                        </td>
                        <td class="item-total">R$ ${formatPtBr(item.totalPrice)}</td>
                        <td>
                            <button type="button" class="btn btn-danger btn-remove" data-price-id="${item.productPriceId}" style="padding: 0.25rem 0.5rem;">🗑️</button>
                        </td>
                    </tr>
                `).join('');
                errorDiv.style.display = 'none';
            }

            document.getElementById('subtotal').textContent = 'R$ ' + formatPtBr(cart.subtotal);
            document.getElementById('itemsDiscount').textContent = 'R$ ' + formatPtBr(cart.items.reduce((sum, i) => sum + i.discount, 0));
            document.getElementById('totalAmount').textContent = 'R$ ' + formatPtBr(cart.totalAmount);

            // Atualiza resumo de pagamento quando o total muda
            updatePaymentSummary();
        }

        // Inicializa
        updatePaymentSummary();
    </script>
}