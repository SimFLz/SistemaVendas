@model SalesManagement.Models.Product
@{
    ViewData["Title"] = "Novo Produto";
}

<div class="card" style="max-width: 600px;">
    <div class="card-header">
        <span class="card-title">📦 Novo Produto</span>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display: @(ViewData.ModelState.IsValid ? "none" : "block");"></div>

        <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-input" placeholder="Ex: Camisa Básica Branca" />
            <span asp-validation-for="Name" style="color: var(--danger); font-size: 0.875rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-input" placeholder="Ex: 001" />
            <span asp-validation-for="Code" style="color: var(--danger); font-size: 0.875rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-input" type="number" step="0.01" min="0.01" placeholder="49,90" />
            <span asp-validation-for="Price" style="color: var(--danger); font-size: 0.875rem;"></span>
        </div>

        <div class="form-group">
            <label class="form-label" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                <input asp-for="IsActive" type="checkbox" checked />
                <span>Ativo</span>
            </label>
        </div>

        <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary">💾 Salvar</button>
            <a href="/Products" class="btn btn-secondary">← Voltar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}