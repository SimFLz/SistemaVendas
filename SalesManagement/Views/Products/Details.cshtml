@model SalesManagement.Models.Product
@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="card" style="max-width: 700px;">
    <div class="card-header">
        <span class="card-title">👁️ Detalhes do Produto</span>
    </div>

    <div style="margin-bottom: 1.5rem;">
        <div style="margin-bottom: 1rem;">
            <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Código</label>
            <p style="font-size: 1.25rem; font-weight: 700;">@Model.Code</p>
        </div>

        <div style="margin-bottom: 1rem;">
            <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Nome</label>
            <p style="font-size: 1.125rem;">@Model.Name</p>
        </div>

        <div style="margin-bottom: 1rem;">
            <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Status</label>
            <p>
                @if (Model.IsActive)
                {
                    <span style="color: var(--success); font-weight: 600;">✓ Ativo</span>
                }
                else
                {
                    <span style="color: var(--danger);">✗ Inativo</span>
                }
            </p>
        </div>

        <div style="margin-bottom: 1rem;">
            <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600;">Preços</label>
            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Código de Barras</th>
                            <th>Preço</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var price in Model.Prices.OrderBy(p => p.Price))
                        {
                            <tr>
                                <td><code>@price.Barcode</code></td>
                                <td>@price.Price.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div style="display: flex; gap: 0.75rem;">
        <a href="/Products/Edit/@Model.Id" class="btn btn-primary">✏️ Editar</a>
        <a href="/Products" class="btn btn-secondary">← Voltar</a>
    </div>
</div>