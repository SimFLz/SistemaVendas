@model SalesManagement.ViewModels.StoreSettingsViewModel
@{
    ViewData["Title"] = "Configurações da Loja";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card" style="max-width: 700px;">
    <div class="card-header">
        <span class="card-title">⚙️ Configurações da Loja</span>
    </div>

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div style="margin-bottom: 1.5rem;">
            <h3 style="font-size: 1rem; color: var(--text-muted); margin-bottom: 1rem; text-transform: uppercase;">
                🏪 Dados da Loja
            </h3>

            <div class="form-group">
                <label asp-for="StoreName" class="form-label"></label>
                <input asp-for="StoreName" class="form-input" placeholder="Ex: SalesUP Modas" />
                <span asp-validation-for="StoreName" style="color: var(--danger); font-size: 0.875rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Cnpj" class="form-label"></label>
                <input asp-for="Cnpj" class="form-input" placeholder="00.000.000/0000-00" />
                <span asp-validation-for="Cnpj" style="color: var(--danger); font-size: 0.875rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="StoreAddress" class="form-label"></label>
                <input asp-for="StoreAddress" class="form-input" placeholder="Rua, número, bairro, cidade" />
                <span asp-validation-for="StoreAddress" style="color: var(--danger); font-size: 0.875rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="StorePhone" class="form-label"></label>
                <input asp-for="StorePhone" class="form-input" placeholder="(11) 99999-9999" />
                <span asp-validation-for="StorePhone" style="color: var(--danger); font-size: 0.875rem;"></span>
            </div>
        </div>

        <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid var(--border);" />

        <div style="margin-bottom: 1.5rem;">
            <h3 style="font-size: 1rem; color: var(--text-muted); margin-bottom: 1rem; text-transform: uppercase;">
                🔐 Acesso ao Sistema
            </h3>

            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" placeholder="admin@salesup.com" />
                <span asp-validation-for="Email" style="color: var(--danger); font-size: 0.875rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-input" placeholder="Deixe em branco para manter a atual" />
                <span asp-validation-for="NewPassword" style="color: var(--danger); font-size: 0.875rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-input" placeholder="Repita a nova senha" />
                <span asp-validation-for="ConfirmPassword" style="color: var(--danger); font-size: 0.875rem;"></span>
            </div>
        </div>

        <div style="display: flex; gap: 0.75rem;">
            <button type="submit" class="btn btn-primary">💾 Salvar Alterações</button>
            <a href="/Sales" class="btn btn-secondary">← Voltar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}