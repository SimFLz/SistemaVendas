@model SalesManagement.ViewModels.DashboardViewModel
@using SalesManagement.Models.Enums
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-grid">
    <div class="stat-card">
        <div class="label">💰 Receita Hoje</div>
        <div class="value primary">@Model.TotalRevenueToday.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
    </div>
    <div class="stat-card">
        <div class="label">🛒 Vendas Hoje</div>
        <div class="value">@Model.TotalSalesToday</div>
    </div>
    <div class="stat-card">
        <div class="label">📊 Ticket Médio</div>
        <div class="value success">@Model.AverageTicketToday.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
    <!-- Vendas por Pagamento -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">💳 Vendas por Pagamento (Hoje)</span>
        </div>
        @if (Model.SalesByPaymentMethod.Any())
        {
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                @foreach (var item in Model.SalesByPaymentMethod)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: var(--bg); border-radius: 0.375rem;">
                        <span>
                            @(item.Key switch {
                                PaymentMethod.Cash => "💵 Dinheiro",
                                PaymentMethod.DebitCard => "💳 Débito",
                                PaymentMethod.CreditCard => "💳 Crédito",
                                PaymentMethod.Pix => "📱 PIX",
                                _ => item.Key.ToString()
                            })
                        </span>
                        <span style="font-weight: 600;">@item.Value.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); text-align: center; padding: 1rem;">Nenhuma venda hoje.</p>
        }
    </div>

    <!-- Vendas Recentes -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">🕐 Vendas Recentes</span>
        </div>
        @if (Model.RecentSales.Any())
        {
            <div class="table-container">
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Data</th>
                            <th>Valor</th>
                            <th>Pagamento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in Model.RecentSales)
                        {
                            <tr>
                                <td><a href="/Sales/Details/@sale.Id">#@sale.Id</a></td>
                                <td>@sale.SaleDate.ToString("dd/MM HH:mm")</td>
                                <td>@sale.TotalAmount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                                <td>
                                    @(sale.PaymentMethod switch {
                                        PaymentMethod.Cash => "💵",
                                        PaymentMethod.DebitCard => "💳",
                                        PaymentMethod.CreditCard => "💳",
                                        PaymentMethod.Pix => "📱",
                                        _ => ""
                                    })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="color: var(--text-muted); text-align: center; padding: 1rem;">Nenhuma venda registrada.</p>
        }
    </div>
</div>